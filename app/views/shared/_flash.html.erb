<% flash.each do |tipo, mensagem| %>
  <% alerta = tipo.to_s == "alert" %>
  <div class="flash <%= alerta ? "flash-alerta" : "flash-sucesso" %>" role="<%= alerta ? "alert" : "status" %>">
    <%= icone(alerta ? :alerta : :confirmar, tamanho: 18) %>
    <span><%= mensagem %></span>
  </div>
<% end %>
