<%# F11 — Filtros, totais, lançamentos e exportação do extrato (responsável: Tarsila). %>
<% r = relatorio %>
<section class="cartao" id="extrato-exportacao">
  <h2>Lançamentos e exportação</h2>

  <%= form_with url: extrato_path, method: :get, class: "extrato-filtros", id: "extrato-filtros" do |form| %>
    <div class="campo">
      <%= form.label :periodo, "Período de referência" %>
      <%= form.select :periodo, r.opcoes_periodo, { selected: r.periodo }, class: "extrato-seletor" %>
    </div>
    <div class="campo">
      <%= form.label :tipo, "Tipo de refeição" %>
      <%= form.select :tipo, r.opcoes_tipo, { selected: r.tipo }, class: "extrato-seletor" %>
    </div>
    <div class="campo">
      <%= form.label :catraca_id, "Catraca" %>
      <%= form.select :catraca_id, r.opcoes_catraca, { selected: r.catraca_id.to_s }, class: "extrato-seletor" %>
    </div>
    <%= form.submit "Filtrar", name: nil, class: "botao botao-secundario" %>
  <% end %>

  <dl class="extrato-totais" id="extrato-totais">
    <div><dt>Total gasto</dt><dd id="total-gasto"><%= moeda(r.total_gasto) %></dd></div>
    <div><dt>Refeições realizadas</dt><dd id="refeicoes-realizadas"><%= r.refeicoes_realizadas %></dd></div>
    <div><dt>Total recarregado</dt><dd id="total-recarregado"><%= moeda(r.total_recarregado) %></dd></div>
  </dl>

  <% if r.vazio? %>
    <p class="texto-suave" id="lancamentos-vazio">Não há lançamentos para os filtros selecionados.</p>
  <% else %>
    <div class="tabela-rolagem">
      <table class="tabela" id="lancamentos">
        <thead><tr><th>Data e hora</th><th>Evento</th><th>Local</th><th>Catraca</th><th>Valor</th></tr></thead>
        <tbody>
          <% r.lancamentos.each do |lancamento| %>
            <tr class="<%= lancamento.credito? ? "movimentacao-credito" : "movimentacao-debito" %>">
              <td><%= lancamento.momento.strftime("%d/%m/%Y %H:%M") %></td>
              <td><%= lancamento.evento %></td>
              <td><%= lancamento.local || "—" %></td>
              <td><%= lancamento.catraca || "—" %></td>
              <td><%= lancamento.credito? ? "+ " : "− " %><%= moeda(lancamento.valor.abs) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="extrato-exportar">
    <%= render "extratos/botoes_exportacao", relatorio: r, habilitado: true %>
  </div>
</section>
