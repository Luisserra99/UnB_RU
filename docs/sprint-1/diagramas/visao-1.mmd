    PAPEL {
        bigint id PK
        string codigo UK
    }
    USUARIO_PAPEL {
        bigint usuario_id PK, FK
        bigint papel_id PK, FK
    }
    ESTUDANTE {
        bigint id PK
        bigint usuario_id FK, UK
        string matricula UK
        boolean vinculo_ativo
    }
